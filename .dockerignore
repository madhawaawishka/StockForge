# Only what the Maven build needs goes into the build context: smaller uploads, better layer caching, and no local
# build output, IDE files or secrets in an image.
**/target/
.git/
.github/
.idea/
.vscode/
*.iml
*.log
.env
.env.*
*.pem
*.key
docs/
load-tests/
observability/
infra/
scripts/
database/
*.docx
*.md
Dockerfile
docker-compose*.yml
