# Normalize line endings: LF in the repository and in working trees,
# so shell scripts (mvnw) and formatter checks behave the same on Windows, macOS, Linux and CI.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.docx binary
*.pdf binary
