          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(stockforge_outbox_publish_lag_seconds_bucket{le=\"1.0\"}[1h])) / clamp_min(sum(increase(stockforge_outbox_publish_lag_seconds_count[1h])), 1e-9)",
