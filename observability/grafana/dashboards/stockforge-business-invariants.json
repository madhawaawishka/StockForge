      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 6,
      "title": "Dead-Letter Queue (DLT) Messages",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(kafka_consumergroup_lag{topic=~\".*-dlt\"}) or vector(0)",
          "legendFormat": "DLQ Messages"
        }
