<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.stockforge</groupId>
    <artifactId>stockforge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>StockForge</name>
    <description>High-concurrency inventory and reservation platform</description>
    <url>https://github.com/madhawaawishka/StockForge</url>

    <modules>
        <module>libs/proto</module>
        <module>libs/event-schemas</module>
        <module>libs/messaging</module>
        <module>services/inventory-service</module>
        <module>services/order-service</module>
        <module>services/api-gateway</module>
        <module>services/payment-service</module>
        <module>services/notification-worker</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Security overrides of versions Spring Boot 4.1.1 manages: Trivy found CRITICAL CVEs in Tomcat 11.0.24 and
             HIGH ones in Jackson 3.1.5 / 2.21.5 (2026-10-16), all fixed in the patch releases below. Boot's own
             version properties keep the override in one visible place; delete each line once a Boot release ships
             the same or a newer version. -->
        <tomcat.version>11.0.25</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <!-- Transitive dependency of kafka-clients (HIGH CVE in 1.10.1); remove with a kafka-clients release that has it. -->
        <lz4-java.version>1.11.4</lz4-java.version>

        <!-- Versions not managed by Spring Boot. gRPC, protobuf, Testcontainers, Awaitility and
             OpenTelemetry versions come from the Spring Boot BOM so every module agrees on them. -->
        <archunit.version>1.5.1</archunit.version>
        <springdoc.version>3.1.1</springdoc.version>
        <spotless.version>3.10.3</spotless.version>
        <palantir-java-format.version>2.102.0</palantir-java-format.version>
        <jacoco.version>0.8.15</jacoco.version>
        <errorprone.version>2.50.0</errorprone.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <jqwik.version>1.10.2</jqwik.version>
        <!-- Code generation must match the runtime versions managed by Spring Boot 4.1 -->
        <protoc.version>4.35.1</protoc.version>
        <grpc-codegen.version>1.83.1</grpc-codegen.version>
        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <!-- Resilience (spec §23): Spring Boot 4 starter, so YAML instance configuration and metrics apply -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot4</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-micrometer</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <!-- Property-based tests (spec §29) -->
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
            </dependency>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.stockforge</groupId>
                <artifactId>proto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stockforge</groupId>
                <artifactId>event-schemas</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.stockforge</groupId>
                <artifactId>messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>${os-maven-plugin.version}</version>
            </extension>
        </extensions>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- Treat compiler warnings as errors so they are fixed, not accumulated -->
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-serial</arg>
                            <!-- Error Prone: static analysis for common Java bug patterns, run inside javac.
                                 Its JDK-internal access flags live in .mvn/jvm.config. -->
                            <arg>-XDcompilePolicy=simple</arg>
                            <arg>--should-stop=ifError=FLOW</arg>
                            <!-- Required by Error Prone on JDK 21 (CI and the Docker build use Temurin 21); a no-op
                                 on newer JDKs. Without it, every compile on JDK 21 fails. -->
                            <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                            <arg>-Xplugin:ErrorProne</arg>
                        </compilerArgs>
                        <failOnWarning>true</failOnWarning>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>com.google.errorprone</groupId>
                                <artifactId>error_prone_core</artifactId>
                                <version>${errorprone.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Formatting is checked in the verify phase; run `./mvnw spotless:apply` to fix -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                            <formatJavadoc>true</formatJavadoc>
                        </palantirJavaFormat>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- One coverage file for unit + integration tests; report generated in verify -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
